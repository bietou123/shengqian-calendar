<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ 用系统 SplashScreen API 画启动屏，颜色/图标必须用 android: 前缀的
         系统属性声明，否则会回退到窗口背景色和默认应用图标（白底闪一下）。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/appBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:navigationBarColor">@color/appBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
